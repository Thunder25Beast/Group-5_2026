{
  "cli": {
    "version": ">= 21.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "node": "20.10.0",
      "android": { "image": "latest" },
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "node": "20.10.0",
      "android": { "image": "latest", "buildType": "apk" },
      "distribution": "internal"
    },
    "production": {
      "node": "20.10.0",
      "android": { "image": "latest" },
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
